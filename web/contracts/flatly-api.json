{
  "openapi": "3.1.1",
  "info": {
    "title": "Flatly.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5080/"
    }
  ],
  "paths": {
    "/api/v1/platform/validation-sample": {
      "post": {
        "tags": [
          "Platform"
        ],
        "summary": "Sample endpoint showing field-keyed validation errors (400 ProblemDetails).",
        "operationId": "ValidationSample",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationSampleRequest"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/clock-sample": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Sample endpoint returning the time from the injectable clock.",
        "operationId": "ClockSample",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockSampleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/profile": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Returns the signed-in member's profile.",
        "operationId": "GetProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Platform"
        ],
        "summary": "Replaces the signed-in member's profile: name, avatar, language and time zone.",
        "operationId": "UpdateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flats": {
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Creates a flat. The signed-in account becomes its admin.",
        "operationId": "CreateFlat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Lists the flats the signed-in account is a member of, oldest first.",
        "operationId": "ListMyFlats",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlatResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flats/{flatId}": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Gets a flat the signed-in account is an active member of. Other flats answer 404.",
        "operationId": "GetFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "Flats"
        ],
        "summary": "Renames a flat. Only an admin of the flat may do it; members get 403.",
        "operationId": "RenameFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/flats/{flatId}/members": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Lists the active members of a flat, admins first. Members who have left are not listed.",
        "operationId": "ListFlatMembers",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlatMemberResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/platform/auth/session": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "The signed-in member. Returns 401 when there is no session.",
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/platform/auth/antiforgery-token": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Issues the antiforgery token that state-changing requests send in the X-XSRF-TOKEN header.",
        "operationId": "GetAntiforgeryToken",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AntiforgeryTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/auth/sign-out": {
      "post": {
        "tags": [
          "Platform"
        ],
        "summary": "Ends the session. Requires the antiforgery token in the X-XSRF-TOKEN header.",
        "operationId": "SignOut",
        "parameters": [
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/v1/platform/account": {
      "delete": {
        "tags": [
          "Platform"
        ],
        "summary": "Deletes the signed-in member's account. The member leaves every flat, and their name shows as a former member there. The last admin of a flat with other members cannot delete the account (409). Requires the antiforgery token in the X-XSRF-TOKEN header.",
        "operationId": "DeleteAccount",
        "parameters": [
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "description": "Antiforgery token, from `GET /api/v1/platform/auth/antiforgery-token`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The account was deleted."
          },
          "400": {
            "description": "The antiforgery token is missing or invalid."
          },
          "401": {
            "description": "No signed-in account."
          },
          "409": {
            "description": "The member is the last admin of a flat with other members. The problem lists those flats."
          }
        }
      }
    },
    "/api/v1/platform/account/export": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Returns the signed-in member's data: their profile and every flat membership, active or left.",
        "operationId": "ExportAccount",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountExportResponse"
                }
              }
            }
          },
          "401": {
            "description": "No signed-in account."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClockSampleResponse": {
        "required": [
          "utcNow"
        ],
        "type": "object",
        "properties": {
          "utcNow": {
            "type": "string",
            "description": "The current time, in UTC.",
            "format": "date-time"
          }
        },
        "description": "Response of the clock sample: the current instant as the application's clock reports it."
      },
      "CreateFlatRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 80 characters."
          }
        },
        "description": "Request to create a flat."
      },
      "FlatMemberResponse": {
        "required": [
          "userId",
          "displayName",
          "avatarUrl",
          "role",
          "joinedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Identifier of the member's account.",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "description": "Name the member shows in the flat."
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Absolute https URL of the avatar, or null when there is none."
          },
          "role": {
            "type": "string",
            "description": "The member's role in the flat: `Admin` or `Member`."
          },
          "joinedAt": {
            "type": "string",
            "description": "When the member joined the flat, in UTC.",
            "format": "date-time"
          }
        },
        "description": "An active member of a flat, as seen by the other members."
      },
      "FlatResponse": {
        "required": [
          "id",
          "name",
          "createdAt",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the flat.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Name of the flat."
          },
          "createdAt": {
            "type": "string",
            "description": "When the flat was created, in UTC.",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "description": "The caller's role in the flat: `Admin` or `Member`."
          }
        },
        "description": "A flat as seen by one of its members."
      },
      "ProfileResponse": {
        "required": [
          "displayName",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Name shown to the other members of the flat."
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Absolute https URL of the avatar, or null when there is none."
          },
          "preferredLanguage": {
            "type": "string",
            "description": "Interface language: `es` or `en`."
          },
          "timeZoneId": {
            "type": "string",
            "description": "IANA time zone identifier, for example `Europe/Madrid`."
          }
        },
        "description": "The profile of the signed-in member."
      },
      "UpdateFlatRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 80 characters."
          }
        },
        "description": "Request to rename a flat."
      },
      "UpdateProfileRequest": {
        "required": [
          "displayName",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeZoneId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The full profile sent to `PUT profile`. Every field replaces the stored value, so an absent or empty\n`avatarUrl` removes the avatar."
      },
      "ValidationSampleRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 50 characters."
          }
        },
        "description": "Request of the sample endpoint that demonstrates field-keyed validation errors."
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "userId",
          "displayName",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The Flatly account id."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown to the other members of a flat."
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Picture URL, or null."
          },
          "preferredLanguage": {
            "type": "string",
            "description": "Interface language, es or en."
          },
          "timeZoneId": {
            "type": "string",
            "description": "IANA time zone identifier."
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "type": "object",
        "required": [
          "requestToken"
        ],
        "properties": {
          "requestToken": {
            "type": "string",
            "description": "The antiforgery request token."
          }
        }
      },
      "AccountMembershipExport": {
        "required": [
          "flatId",
          "flatName",
          "role",
          "joinedAt",
          "leftAt"
        ],
        "type": "object",
        "properties": {
          "flatId": {
            "type": "string",
            "format": "uuid"
          },
          "flatName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "`Admin` or `Member`."
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the member joined, in UTC."
          },
          "leftAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time",
            "description": "When the member left, in UTC, or null while the membership is active."
          }
        },
        "description": "One membership of the member, active or left, in a flat."
      },
      "AccountProfileExport": {
        "required": [
          "displayName",
          "email",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email the sign-in provider reported, or null."
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "preferredLanguage": {
            "type": "string"
          },
          "timeZoneId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the account was created, in UTC."
          }
        },
        "description": "The profile part of the account export."
      },
      "AccountExportResponse": {
        "required": [
          "exportedAt",
          "profile",
          "memberships"
        ],
        "type": "object",
        "properties": {
          "exportedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the export was made, in UTC."
          },
          "profile": {
            "$ref": "#/components/schemas/AccountProfileExport"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountMembershipExport"
            },
            "description": "Every flat the member has been in, oldest first."
          }
        },
        "description": "The data export of the signed-in member."
      }
    }
  },
  "tags": [
    {
      "name": "Platform"
    },
    {
      "name": "Flats"
    }
  ]
}
