{
  "openapi": "3.1.1",
  "info": {
    "title": "Flatly.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5080/"
    }
  ],
  "paths": {
    "/api/v1/platform/validation-sample": {
      "post": {
        "tags": [
          "Platform"
        ],
        "summary": "Sample endpoint showing field-keyed validation errors (400 ProblemDetails).",
        "operationId": "ValidationSample",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationSampleRequest"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/clock-sample": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Sample endpoint returning the time from the injectable clock.",
        "operationId": "ClockSample",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockSampleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/profile": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Returns the signed-in member's profile.",
        "operationId": "GetProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Platform"
        ],
        "summary": "Replaces the signed-in member's profile: name, avatar, language and time zone.",
        "operationId": "UpdateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flats": {
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Creates a flat. The signed-in account becomes its admin.",
        "operationId": "CreateFlat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Lists the flats the signed-in account is a member of, oldest first.",
        "operationId": "ListMyFlats",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlatResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flats/{flatId}": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Gets a flat the signed-in account is an active member of. Other flats answer 404.",
        "operationId": "GetFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "Flats"
        ],
        "summary": "Renames a flat. Only an admin of the flat may do it; members get 403.",
        "operationId": "RenameFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/flats/{flatId}/members": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Lists the active members of a flat, admins first. Members who have left are not listed.",
        "operationId": "ListFlatMembers",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlatMemberResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/platform/auth/session": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "The signed-in member. Returns 401 when there is no session.",
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/platform/auth/antiforgery-token": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Issues the antiforgery token that state-changing requests send in the X-XSRF-TOKEN header.",
        "operationId": "GetAntiforgeryToken",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AntiforgeryTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/auth/sign-out": {
      "post": {
        "tags": [
          "Platform"
        ],
        "summary": "Ends the session. Requires the antiforgery token in the X-XSRF-TOKEN header.",
        "operationId": "SignOut",
        "parameters": [
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/v1/flats/{flatId}/leave": {
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Leaves a flat. The membership is kept as history. The last admin of a flat with other members cannot leave, so the flat always keeps an admin.",
        "operationId": "LeaveFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/v1/flats/{flatId}/members/{userId}": {
      "patch": {
        "tags": [
          "Flats"
        ],
        "summary": "Promotes or demotes an active member of a flat. Only an admin may do it; members get 403. The sole admin of a flat cannot be demoted, so the flat always keeps an admin (409).",
        "operationId": "ChangeFlatMemberRole",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeMemberRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      },
      "delete": {
        "tags": [
          "Flats"
        ],
        "summary": "Removes a member from a flat. Only an admin may do it; members get 403. Admins cannot remove themselves: they use the leave endpoint. Other flats and non-members answer 404.",
        "operationId": "RemoveFlatMember",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Lists the signed-in account's notifications, newest first. Use unread=true for the unread ones only.",
        "operationId": "ListNotifications",
        "parameters": [
          {
            "name": "unread",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/unread-count": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Counts the signed-in account's unread notifications.",
        "operationId": "GetUnreadNotificationCount",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/{notificationId}/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Marks one of the signed-in account's notifications as read. Marking it again changes nothing.",
        "operationId": "MarkNotificationRead",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Marks every unread notification of the signed-in account as read.",
        "operationId": "MarkAllNotificationsRead",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/flats/{flatId}/invite-code": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Gets the invite code of a flat and when it expires. Only an admin may read it; members get 403.",
        "operationId": "GetFlatInviteCode",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/flats/{flatId}/invite-code/regenerate": {
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Replaces the invite code of a flat with a new one that lasts seven days. The previous code stops working. Only an admin may do it; members get 403.",
        "operationId": "RegenerateFlatInviteCode",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/flats/join": {
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Joins a flat with its invite code as a Member. Joining again while still a member changes nothing. An unknown code answers 404 and an expired code answers 410. Attempts are rate-limited per account and answer 429.",
        "operationId": "JoinFlat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinFlatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "410": {
            "description": "Gone"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClockSampleResponse": {
        "required": [
          "utcNow"
        ],
        "type": "object",
        "properties": {
          "utcNow": {
            "type": "string",
            "description": "The current time, in UTC.",
            "format": "date-time"
          }
        },
        "description": "Response of the clock sample: the current instant as the application's clock reports it."
      },
      "CreateFlatRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 80 characters."
          }
        },
        "description": "Request to create a flat."
      },
      "FlatMemberResponse": {
        "required": [
          "userId",
          "displayName",
          "avatarUrl",
          "role",
          "joinedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Identifier of the member's account.",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "description": "Name the member shows in the flat."
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Absolute https URL of the avatar, or null when there is none."
          },
          "role": {
            "type": "string",
            "description": "The member's role in the flat: `Admin` or `Member`."
          },
          "joinedAt": {
            "type": "string",
            "description": "When the member joined the flat, in UTC.",
            "format": "date-time"
          }
        },
        "description": "An active member of a flat, as seen by the other members."
      },
      "FlatResponse": {
        "required": [
          "id",
          "name",
          "createdAt",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the flat.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Name of the flat."
          },
          "createdAt": {
            "type": "string",
            "description": "When the flat was created, in UTC.",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "description": "The caller's role in the flat: `Admin` or `Member`."
          }
        },
        "description": "A flat as seen by one of its members."
      },
      "ProfileResponse": {
        "required": [
          "displayName",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Name shown to the other members of the flat."
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Absolute https URL of the avatar, or null when there is none."
          },
          "preferredLanguage": {
            "type": "string",
            "description": "Interface language: `es` or `en`."
          },
          "timeZoneId": {
            "type": "string",
            "description": "IANA time zone identifier, for example `Europe/Madrid`."
          }
        },
        "description": "The profile of the signed-in member."
      },
      "UpdateFlatRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 80 characters."
          }
        },
        "description": "Request to rename a flat."
      },
      "UpdateProfileRequest": {
        "required": [
          "displayName",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeZoneId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The full profile sent to `PUT profile`. Every field replaces the stored value, so an absent or empty\n`avatarUrl` removes the avatar."
      },
      "ValidationSampleRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 50 characters."
          }
        },
        "description": "Request of the sample endpoint that demonstrates field-keyed validation errors."
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "userId",
          "displayName",
          "avatarUrl",
          "preferredLanguage",
          "timeZoneId"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The Flatly account id."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown to the other members of a flat."
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Picture URL, or null."
          },
          "preferredLanguage": {
            "type": "string",
            "description": "Interface language, es or en."
          },
          "timeZoneId": {
            "type": "string",
            "description": "IANA time zone identifier."
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "type": "object",
        "required": [
          "requestToken"
        ],
        "properties": {
          "requestToken": {
            "type": "string",
            "description": "The antiforgery request token."
          }
        }
      },
      "ChangeMemberRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required: `Admin` or `Member`."
          }
        },
        "description": "Request to promote or demote a member of a flat."
      },
      "NotificationResponse": {
        "required": [
          "id",
          "flatId",
          "category",
          "text",
          "linkTarget",
          "createdAt",
          "readAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the notification.",
            "format": "uuid"
          },
          "flatId": {
            "type": "string",
            "description": "The flat the notification is about.",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "description": "The area it comes from: `Flats`, `Chores` or `Maintenance`."
          },
          "text": {
            "type": "string",
            "description": "The text, rendered in the recipient's language."
          },
          "linkTarget": {
            "type": [
              "null",
              "string"
            ],
            "description": "A relative path inside Flatly, or null."
          },
          "createdAt": {
            "type": "string",
            "description": "When the notification was created, in UTC.",
            "format": "date-time"
          },
          "readAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the recipient read it, in UTC. Null while it is unread.",
