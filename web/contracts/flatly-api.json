{
  "openapi": "3.1.1",
  "info": {
    "title": "Flatly.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5080/"
    }
  ],
  "paths": {
    "/api/v1/platform/validation-sample": {
      "post": {
        "tags": [
          "Platform"
        ],
        "summary": "Sample endpoint showing field-keyed validation errors (400 ProblemDetails).",
        "operationId": "ValidationSample",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationSampleRequest"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/clock-sample": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Sample endpoint returning the time from the injectable clock.",
        "operationId": "ClockSample",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockSampleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flats": {
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Creates a flat. The signed-in account becomes its admin.",
        "operationId": "CreateFlat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Lists the flats the signed-in account is a member of, oldest first.",
        "operationId": "ListMyFlats",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlatResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flats/{flatId}": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Gets a flat the signed-in account is an active member of. Other flats answer 404.",
        "operationId": "GetFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClockSampleResponse": {
        "required": [
          "utcNow"
        ],
        "type": "object",
        "properties": {
          "utcNow": {
            "type": "string",
            "description": "The current time, in UTC.",
            "format": "date-time"
          }
        },
        "description": "Response of the clock sample: the current instant as the application's clock reports it."
      },
      "CreateFlatRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 80 characters."
          }
        },
        "description": "Request to create a flat."
      },
      "FlatResponse": {
        "required": [
          "id",
          "name",
          "createdAt",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the flat.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Name of the flat."
          },
          "createdAt": {
            "type": "string",
            "description": "When the flat was created, in UTC.",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "description": "The caller's role in the flat: `Admin` or `Member`."
          }
        },
        "description": "A flat as seen by one of its members."
      },
      "ValidationSampleRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, at most 50 characters."
          }
        },
        "description": "Request of the sample endpoint that demonstrates field-keyed validation errors."
      }
    }
  },
  "tags": [
    {
      "name": "Platform"
    },
    {
      "name": "Flats"
    }
  ]
}
